# ============================================================
# Employee Management System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# Production Checklist:
#   ✅ Generate a 50+ character SECRET_KEY
#   ✅ Set DEBUG=False
#   ✅ Set ALLOWED_HOSTS to your domain
#   ✅ Set CORS_ALLOWED_ORIGINS to your frontend URL
#   ✅ Set all SECURE_* settings to True
#   ✅ Switch DATABASE_URL to PostgreSQL
#   ✅ Set LOG_LEVEL=WARNING in production

# ------------------------------------
# Django Core
# ------------------------------------
# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-at-least-50-characters-long

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ------------------------------------
# Database
# ------------------------------------
# Default: SQLite (development only)
# DATABASE_URL=sqlite:///db.sqlite3

# For production PostgreSQL (requires: pip install dj-database-url psycopg2-binary):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ------------------------------------
# JWT Settings
# ------------------------------------
# Access token lifetime in minutes (shorter = more secure)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------
# CORS
# ------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# ------------------------------------
# CSRF Trusted Origins (required in Django 4/5 for POST/PUT requests)
# ------------------------------------
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://localhost,https://your-domain.com

# ------------------------------------
# Security (set ALL to True in production!)
# ------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ------------------------------------
# Logging
# ------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use WARNING or ERROR in production to reduce log volume
LOG_LEVEL=INFO
